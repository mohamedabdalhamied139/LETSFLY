# Production environment template — never commit real values.
LETSFLY_ENV=production
LETSFLY_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
LETSFLY_CORS_ORIGINS=https://letsfly.onrender.com
LETSFLY_ALLOWED_HOSTS=letsfly.onrender.com
LETSFLY_REQUIRE_HTTPS=true
# Set this to the IP/CIDR of the trusted reverse proxy only.
LETSFLY_FORWARDED_ALLOW_IPS=127.0.0.1
LETSFLY_BIND_HOST=127.0.0.1
LETSFLY_PORT=8000
LETSFLY_LOG_LEVEL=info
# Keep one Uvicorn worker while rate limiting is process-local.
# Do not expose port 8000 directly to the Internet.
LETSFLY_WORKERS=1
LETSFLY_JWT_ISSUER=letsfly
LETSFLY_JWT_AUDIENCE=letsfly-client
LETSFLY_ACCESS_TOKEN_EXPIRE_MINUTES=1440
LETSFLY_SERVER_URL=https://letsfly.onrender.com

# Required in production: use the Render PostgreSQL connection URL.
DATABASE_URL=REPLACE_WITH_RENDER_POSTGRES_URL
